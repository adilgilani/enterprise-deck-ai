# Copy to .env (root, used by docker compose) and/or backend/.env (local uvicorn). Never commit real secrets.

# --- Core ---------------------------------------------------------------------
ENVIRONMENT=development
# Local without Docker: leave unset to use SQLite at backend/data/dev.db
# Docker / production:  postgresql+asyncpg://USER:PASS@HOST:5432/DB  (pgvector image)
DATABASE_URL=
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
PUBLIC_APP_URL=http://localhost:8080
PGVECTOR_ENABLED=true

# --- LLM (qwen | openai_compatible | mock) --------------------------------------
LLM_PROVIDER=mock
# Qwen 3.5 on Alibaba Cloud Model Studio (DashScope, OpenAI-compatible mode)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-plus
QWEN_ENABLE_THINKING=false
# Any OpenAI-compatible server (vLLM, Ollama, self-hosted Qwen 27B, OpenRouter…)
OPENAI_COMPATIBLE_BASE_URL=https://occgocg0g00g8wggko88kw8s.138.252.175.111.sslip.io/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- Embeddings / RAG (hash | fastembed | openai_compatible) -------------------
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=768
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# --- Speech-to-text -----------------------------------------------------------
# English: mock | whisper (faster-whisper, local) | deepgram
STT_PROVIDER_EN=mock
DEEPGRAM_API_KEY=
WHISPER_MODEL=small
# Urdu / mixed Urdu-English: mock | soniox | whisper
STT_PROVIDER_UR=mock
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v4
SONIOX_URL=wss://stt-rt.jp.soniox.com/transcribe-websocket
LIVE_INSIGHT_INTERVAL_SECONDS=15

# --- Storage (local | minio | s3) ---------------------------------------------
STORAGE_PROVIDER=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=enterprise-ai

# --- Jobs (inline | arq | eager) -----------------------------------------------
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- Frontend -----------------------------------------------------------------
VITE_API_URL=http://localhost:8000
